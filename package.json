{
  "name": "sadoku",
  "description": "Preview a Markdown file in a local browser-friendly server.",
  "private": true,
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "build:client": "npm --prefix src/preview run build",
    "install:deps": "npm ci --ignore-scripts && npm ci --prefix src/preview",
    "postinstall": "npm ci --prefix src/preview",
    "proto:generate": "buf generate && prettier --write gen/ts",
    "proto:lint": "buf lint",
    "test": "npm --prefix src/preview test",
    "fmt": "prettier --write scripts/*.mts gen/ts",
    "fmt:check": "prettier --check scripts/*.mts gen/ts",
    "test:actions": "node --test scripts/cloud_run_preview_comment_test.mts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "prettier": "3.9.10"
  }
}
