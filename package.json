{
  "name": "sadoku",
  "description": "Preview a Markdown file in a local browser-friendly server.",
  "private": true,
  "engines": {
    "node": "^26.12.1",
    "deno": "^2.9.8"
  },
  "scripts": {
    "build:client": "npm --prefix src/preview run build",
    "install:deps": "npm ci --ignore-scripts && npm ci --prefix src/preview",
    "postinstall": "npm ci --prefix src/preview",
    "proto:check": "npm run proto:lint && npm run proto:generate && git add --intent-to-add -- gen/ts && git diff --exit-code -- gen/ts",
    "proto:generate": "buf generate && deno fmt gen/ts",
    "proto:lint": "buf lint",
    "test": "npm --prefix src/preview test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0"
  }
}
