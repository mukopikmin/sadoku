{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sadoku-cloud-run-proxy-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "cache": { "enabled": false },
  "vars": {
    "BASE_DOMAIN": "api.example.com",
    "CLOUD_RUN_TAG_HOST": "replace-with-observed-service-host.run.app"
  }
}
