{
  "name": "sadoku-cloud-run-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure.ts",
    "dev": "wrangler dev --local-protocol https",
    "lint": "deno lint src scripts && deno fmt --check .",
    "typecheck": "deno check src/index.ts scripts/configure.ts",
    "typecheck:workers": "wrangler types worker_types.d.ts && deno check --config deno.workers.json src/index.ts test/runtime_worker.ts",
    "test": "deno test src/index_test.ts scripts/configure_test.ts",
    "test:runtime": "node --test --test-timeout=30000 test/runtime.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --config wrangler.deploy.json"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
