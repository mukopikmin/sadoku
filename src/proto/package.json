{
  "name": "sadoku",
  "description": "Preview a Markdown file in a local browser-friendly server.",
  "private": true,
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "proto:generate": "buf generate && cd ../.. && oxfmt \"src/preview/gen/**/*.ts\"",
    "proto:lint": "buf lint",
    "fmt": "cd ../.. && oxfmt \".github/tests/*.mts\" \"src/preview/**/*.{ts,tsx}\"",
    "fmt:check": "cd ../.. && oxfmt --check \".github/tests/*.mts\" \"src/preview/**/*.{ts,tsx}\"",
    "test:actions": "node --test ../../.github/tests/cloud_run_preview_comment_test.mts",
    "lint": "cd ../.. && oxlint --deny-warnings --report-unused-disable-directives .github/tests src/preview"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.92.0"
  }
}
