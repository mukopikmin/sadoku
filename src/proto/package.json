{
  "name": "sadoku",
  "description": "Preview a Markdown file in a local browser-friendly server.",
  "private": true,
  "engines": {
    "node": "^26.12.1"
  },
  "scripts": {
    "proto:generate": "buf generate && prettier --write ../preview/gen",
    "proto:lint": "buf lint",
    "fmt": "prettier --write ../../scripts/*.mts ../preview/gen",
    "fmt:check": "prettier --check ../../scripts/*.mts ../preview/gen",
    "test:actions": "node --test ../../scripts/cloud_run_preview_comment_test.mts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "prettier": "3.9.10"
  }
}
